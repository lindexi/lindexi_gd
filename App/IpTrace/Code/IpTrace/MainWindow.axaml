<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IpTrace.MainWindow"
        Title="IpTrace · 网络诊断"
        Width="1100" Height="780" MinWidth="860" MinHeight="660"
        FontFamily="Segoe UI,Microsoft YaHei UI,Microsoft YaHei,sans-serif"
        FontSize="14" Background="Transparent"
        TransparencyLevelHint="Mica, None"
        TransparencyBackgroundFallback="#F3F3F3">
    <Window.Resources>
        <x:String x:Key="DnsDescription">查询域名对应的 IPv4 和 IPv6 地址，检查名称解析是否正常。</x:String>
        <x:String x:Key="PingDescription">发送 4 次 ICMP 请求，检查网络连通性、往返延迟和丢包情况。</x:String>
        <x:String x:Key="TcpDescription">连接指定 TCP 端口，检查服务是否可达及建立连接所需的时间。</x:String>
        <x:String x:Key="TraceDescription">逐跳追踪网络路径。公网节点地理位置由 api.ip.sb 提供。</x:String>
        <x:String x:Key="ReadyText">等待执行</x:String>
        <x:String x:Key="RunningText">正在诊断…</x:String>
        <x:String x:Key="CompletedText">执行完成</x:String>
        <x:String x:Key="CancelledText">操作已取消</x:String>
        <x:String x:Key="FailedText">执行失败</x:String>
        <x:String x:Key="CancellingText">正在取消…</x:String>
        <x:String x:Key="ElapsedFormat">{0:0.0} 秒</x:String>
        <x:String x:Key="NoTargetText">尚未指定目标</x:String>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="Background" Value="#BFFFFFFF" />
            <Setter Property="BorderBrush" Value="#10000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="16,6" />
        </Style>
        <Style Selector="RadioButton.tool">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="ToolBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="SelectionIndicator" Width="24" Height="3" CornerRadius="2"
                                    Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" IsVisible="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tool:pointerover">
            <Setter Property="Background" Value="#08000000" />
        </Style>
        <Style Selector="RadioButton.tool:checked">
            <Setter Property="Background" Value="#80FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.tool:checked /template/ Border#SelectionIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="RadioButton.tool:focus-visible /template/ Border#ToolBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="RadioButton.tool:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TextBox.target">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="16,8,16,16">
        <StackPanel Margin="0,0,0,10" ToolTip.Tip="{Binding Text, ElementName=ToolDescriptionTextBlock}">
            <UniformGrid Rows="1" Columns="4" HorizontalAlignment="Left">
                <RadioButton x:Name="QueryButton" Classes="tool" GroupName="Tools" IsChecked="True" Click="ModeButton_OnClick" Tag="DNS 解析">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="18" Height="18" Data="M 3,4 L 21,4 21,10 3,10 Z M 3,14 L 21,14 21,20 3,20 Z M 6,7 L 8,7 M 6,17 L 8,17" />
                        <TextBlock Text="DNS 解析" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PingButton" Classes="tool" GroupName="Tools" Click="ModeButton_OnClick" Tag="Ping 检测">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="18" Height="18" Data="M 1,12 L 6,12 9,3 14,21 17,12 23,12 23,14 18,14 14,24 9,9 7,14 1,14 Z" />
                        <TextBlock Text="Ping 检测" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TcpPingButton" Classes="tool" GroupName="Tools" Click="ModeButton_OnClick" Tag="TCP 探测">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="18" Height="18" Data="M 7,1 L 9,1 9,6 15,6 15,1 17,1 17,6 20,6 20,10 C 20,14 17,17 13,18 L 13,23 11,23 11,18 C 7,17 4,14 4,10 L 4,6 7,6 Z" />
                        <TextBlock Text="TCP 探测" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TraceRouteButton" Classes="tool" GroupName="Tools" Click="ModeButton_OnClick" Tag="路由追踪">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Width="18" Height="18" Data="M 2,2 L 8,2 8,8 6,8 6,15 16,15 16,12 22,12 22,18 18,18 18,17 4,17 4,8 2,8 Z" />
                        <TextBlock Text="路由追踪" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
            <TextBlock x:Name="ToolTitleTextBlock" Text="DNS 解析" IsVisible="False" />
            <TextBlock x:Name="ToolDescriptionTextBlock" Text="{StaticResource DnsDescription}" IsVisible="False" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
            <TextBlock Text="目标地址" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox x:Name="TargetTextBox" Classes="target" PlaceholderText="输入域名、IP 地址或网址"
                                 KeyDown="TargetTextBox_OnKeyDown" AutomationProperties.Name="目标地址"
                                 ToolTip.Tip="输入完整网址时自动提取主机名，TCP 端口需单独设置。按 Enter 执行当前诊断。" />
                        <StackPanel x:Name="PortPanel" Grid.Column="1" IsVisible="False" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="端口" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="PortNumericUpDown" Width="110" MinHeight="36" Minimum="1" Maximum="65535"
                                           Value="443" Increment="1" FormatString="0" CornerRadius="4" AutomationProperties.Name="TCP 端口" />
                        </StackPanel>
                        <Button x:Name="RunButton" Grid.Column="2" Classes="accent" Content="开始诊断" Click="RunButton_OnClick" MinWidth="110" />
                    </Grid>
        </Grid>

            <Border Grid.Row="2" Classes="surface">
                <Grid RowDefinitions="Auto,2,*">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="14" Margin="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicator" Width="6" Height="6" Fill="#60A5FA" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusTextBlock" Text="等待执行" Classes="secondary" />
                        </StackPanel>
                        <TextBlock x:Name="SummaryModeTextBlock" Grid.Column="1" Text="DNS 解析" Classes="secondary" VerticalAlignment="Center" />
                        <TextBlock x:Name="SummaryTargetTextBlock" Grid.Column="2" Text="尚未指定目标" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="耗时" Classes="secondary" />
                            <TextBlock x:Name="ElapsedTextBlock" Text="—" Classes="secondary" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelButton" Content="取消" IsVisible="False" IsEnabled="False" Click="CancelButton_OnClick" />
                            <Button x:Name="ClearButton" Content="清空结果" Click="ClearButton_OnClick" Background="Transparent" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" IsVisible="False" IsIndeterminate="True" Height="2" />
                    <Grid Grid.Row="2">
                        <TextBox x:Name="OutputTextBox" IsVisible="False" Margin="8" Padding="10" AcceptsReturn="True" IsReadOnly="True"
                                 TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,Microsoft YaHei UI,monospace" FontSize="14"
                                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="诊断结果"
                                 ToolTip.Tip="结果反映本机当前网络状况。选择文本后可按 Ctrl+C 复制。" />
                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
                            <PathIcon Width="38" Height="38" Margin="0,0,0,4" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                      Data="M 3,3 L 21,3 21,16 13,16 13,20 18,20 18,22 6,22 6,20 11,20 11,16 3,16 Z M 5,5 L 5,14 19,14 19,5 Z" />
                            <TextBlock Text="准备好，开始检查网络" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="输入目标地址并开始诊断，结果将在这里显示。" Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</Window>
