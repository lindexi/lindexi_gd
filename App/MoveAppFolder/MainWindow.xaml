<Window x:Class="MoveAppFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoveAppFolder"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 上方操作区域 -->
        <GroupBox Header="文件夹设置" Grid.Row="0" Margin="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 源文件夹 -->
                <Label Content="源文件夹:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0 0 0 5"/>
                <TextBox x:Name="SourceFolderTextBox" Grid.Row="0" Grid.Column="0" Margin="80 0 10 5"/>
                <Button x:Name="BrowseSourceButton" Content="浏览" Grid.Row="0" Grid.Column="1" Width="80" Margin="0 0 0 5" Click="BrowseSourceButton_Click"/>

                <!-- 目标文件夹 -->
                <Label Content="目标文件夹:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0 0 0 5"/>
                <TextBox x:Name="TargetFolderTextBox" Grid.Row="1" Grid.Column="0" Margin="80 0 10 5"/>
                <Button x:Name="BrowseTargetButton" Content="浏览" Grid.Row="1" Grid.Column="1" Width="80" Margin="0 0 0 5" Click="BrowseTargetButton_Click"/>

                <!-- 开始按钮 -->
                <Button x:Name="StartMoveButton" Content="开始移动" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Width="120" Height="30" Margin="0 10 0 0" Click="StartMoveButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- 下方日志区域 -->
        <GroupBox Header="移动日志" Grid.Row="1" Margin="10" Padding="10">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
        </GroupBox>
    </Grid>
</Window>
