<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>5.1.2600</SupportedOSPlatformVersion>
    <CETCompat>false</CETCompat>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Win32Resource>$(MSBuildProjectDirectory)\XiaoXiIme.res</Win32Resource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VC-LTL" Version="5.2.1" />
    <PackageReference Include="YY-Thunks" Version="1.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XiaoXiIme.Dictionary\XiaoXiIme.Dictionary.csproj" />
    <ProjectReference Include="..\XiaoXiIme.Foundation\XiaoXiIme.Foundation.csproj" />
    <ProjectReference Include="..\XiaoXiIme.ImeCore\XiaoXiIme.ImeCore.csproj" />
    <ProjectReference Include="..\XiaoXiIme.ImeInterop\XiaoXiIme.ImeInterop.csproj" />
    <ProjectReference Include="..\XiaoXiIme.ImeIpc\XiaoXiIme.ImeIpc.csproj" />
  </ItemGroup>

  <Target Name="CreateImeModule" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Delete Files="$(PublishDir)XiaoXiIme.ime;$(PublishDir)XiaoXiIme.ImeCoreNative.dll" />
    <Error Condition="!Exists('$(TargetDir)native\$(AssemblyName).dll')" Text="Native IME output is missing: $(TargetDir)native\$(AssemblyName).dll" />
    <Copy SourceFiles="$(TargetDir)native\$(AssemblyName).dll" DestinationFiles="$(PublishDir)XiaoXiIme.ime" />
  </Target>

</Project>
