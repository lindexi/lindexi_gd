<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XiaoXiIme.ImeUi.Avalonia.CandidateWindow"
        Title="XiaoXiIme Candidate Window"
        x:DataType="local:CandidateWindowViewState"
        xmlns:local="using:XiaoXiIme.ImeUi.Avalonia"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur, Transparent"
        Background="Transparent">
  <Border Margin="6"
          Padding="12,10"
          CornerRadius="10"
          Background="#F7FFFFFF"
          BorderBrush="#33000000"
          BorderThickness="1"
          BoxShadow="0 4 14 0 #33000000">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding CompositionText}"
                   FontSize="13"
                   Foreground="#6B7280" />
        <TextBlock Grid.Column="1"
                   Text="{Binding PageText}"
                   FontSize="12"
                   Foreground="#9CA3AF" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Candidates}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:CandidateWindowCandidateViewModel">
            <Border Padding="8,5"
                    Margin="0,1"
                    CornerRadius="6"
                    Background="{Binding Background}">
              <Grid ColumnDefinitions="28,*,Auto">
                <TextBlock Text="{Binding DisplayIndex}"
                           VerticalAlignment="Center"
                           Foreground="{Binding Foreground}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Text}"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{Binding Foreground}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Reading}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{Binding SecondaryForeground}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding GuidelineText}"
                 IsVisible="{Binding HasGuideline}"
                 FontSize="12"
                 Foreground="#B45309"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
