<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             xmlns:views="using:PrismCodingAgent.AvaloniaShell.Views"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.ModelServiceConnectionView"
             x:DataType="vm:ProviderSettingsViewModel"
             FontFamily="{StaticResource ShellFont}" FontSize="13">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource ShellFont}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource ShellFont}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource ShellFont}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding SetupEndpointText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
            <TextBox Text="{Binding EndPoint, UpdateSourceTrigger=PropertyChanged}" Classes="Rounded SettingsInput"
                     FontSize="13" PlaceholderText="https://api.openai.com/v1" />
            <TextBlock Text="{Binding SetupEndpointHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding SetupKeyText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
            <views:SecretInput Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Classes="Rounded SettingsInput" FontSize="13" />
            <TextBlock Text="{Binding SetupKeyHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
