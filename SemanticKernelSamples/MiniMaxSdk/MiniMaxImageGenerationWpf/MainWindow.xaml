<Window x:Class="MiniMaxImageGenerationWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MiniMax 灵感画布"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="Bold" Text="MiniMax 灵感画布" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="把脑海中的文字，变成清晰可见的画面" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,7" Background="#EAE8FF" CornerRadius="16" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Text="AI IMAGE STUDIO" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock FontSize="17" FontWeight="Bold" Text="创作设置" />
                        <TextBlock Margin="0,4,0,20" Foreground="{StaticResource TextSecondaryBrush}" Text="所有参数均已提供推荐默认值" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="画面描述" />
                        <TextBox x:Name="PromptTextBox"
                                 Height="126"
                                 Margin="0,0,0,4"
                                 AcceptsReturn="True"
                                 MaxLength="1500"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="一只在月光下坐在书堆上的布偶猫，旁边有发光的萤火虫，电影感，细节丰富，高清插画风格" />
                        <TextBlock Margin="0,0,0,16" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="最多 1500 字符" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="模型" />
                                <ComboBox x:Name="ModelComboBox" SelectionChanged="ModelComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="image-01" Tag="image-01" IsSelected="True" />
                                    <ComboBoxItem Content="image-01-live" Tag="image-01-live" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="生成数量" />
                                <ComboBox x:Name="CountComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="1 张" Tag="1" />
                                    <ComboBoxItem Content="2 张" Tag="2" />
                                    <ComboBoxItem Content="3 张" Tag="3" />
                                    <ComboBoxItem Content="4 张" Tag="4" />
                                    <ComboBoxItem Content="5 张" Tag="5" />
                                    <ComboBoxItem Content="6 张" Tag="6" />
                                    <ComboBoxItem Content="7 张" Tag="7" />
                                    <ComboBoxItem Content="8 张" Tag="8" />
                                    <ComboBoxItem Content="9 张" Tag="9" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="画面比例" />
                        <ComboBox x:Name="AspectRatioComboBox" Margin="0,0,0,14" SelectedIndex="0">
                            <ComboBoxItem Content="1:1 · 方形 1024 × 1024" Tag="1:1" />
                            <ComboBoxItem Content="16:9 · 横屏 1280 × 720" Tag="16:9" />
                            <ComboBoxItem Content="4:3 · 标准 1152 × 864" Tag="4:3" />
                            <ComboBoxItem Content="3:2 · 横向 1248 × 832" Tag="3:2" />
                            <ComboBoxItem Content="2:3 · 竖向 832 × 1248" Tag="2:3" />
                            <ComboBoxItem Content="3:4 · 竖向 864 × 1152" Tag="3:4" />
                            <ComboBoxItem Content="9:16 · 手机 720 × 1280" Tag="9:16" />
                            <ComboBoxItem Content="21:9 · 超宽 1344 × 576" Tag="21:9" />
                        </ComboBox>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="随机种子（可选）" />
                                <TextBox x:Name="SeedTextBox" ToolTip="留空时使用随机种子" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="返回格式" />
                                <ComboBox IsEnabled="False" SelectedIndex="0" ToolTip="为支持预览与导出，固定使用 Base64">
                                    <ComboBoxItem Content="Base64" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="PromptOptimizerCheckBox" Margin="0,2,0,12" IsChecked="True" Content="自动优化画面描述" />
                        <CheckBox x:Name="WatermarkCheckBox" Margin="0,0,0,16" Content="添加 AIGC 水印" />

                        <Border x:Name="StylePanel" Margin="0,0,0,16" Padding="12" Background="#F7F7FB" CornerRadius="8" IsEnabled="False">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LIVE 模型画风" />
                                <ComboBox x:Name="StyleComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="不指定" Tag="" />
                                    <ComboBoxItem Content="漫画" Tag="漫画" />
                                    <ComboBoxItem Content="元气" Tag="元气" />
                                    <ComboBoxItem Content="中世纪" Tag="中世纪" />
                                    <ComboBoxItem Content="水彩" Tag="水彩" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="API KEY 文件路径" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiKeyFilePathTextBox"
                                     Text="C:\lindexi\Work\Key\MiniMax.txt"
                                     ToolTip="生成时读取此文本文件中的 MiniMax API Key" />
                            <Button Grid.Column="2"
                                    Padding="14,7"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseApiKeyFileButton_OnClick"
                                    Content="浏览…" />
                        </Grid>

                        <Button x:Name="GenerateButton" Height="46" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateButton_OnClick" Content="生成图片" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="88" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="Bold" Text="作品预览" />
                            <TextBlock x:Name="ResultSummaryTextBlock" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="生成后可在此查看作品" />
                        </StackPanel>
                        <Button x:Name="RegenerateButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="RegenerateButton_OnClick" IsEnabled="False" Content="重新生成" />
                        <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_OnClick" IsEnabled="False" Content="导出当前图片" />
                    </Grid>

                    <Border Grid.Row="2" Background="#F0F2F8" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="EmptyPreviewTextBlock"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       Text="在左侧描述你的想法&#x0a;第一幅作品将在这里呈现" />
                            <Image x:Name="PreviewImage" Margin="18" Stretch="Uniform" />
                            <Border x:Name="BusyOverlay" Background="#BFFFFFFF" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="220" Height="5" IsIndeterminate="True" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Margin="0,16,0,0" FontSize="15" FontWeight="SemiBold" Text="正在构思并绘制画面…" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="生成可能需要一些时间" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ListBox x:Name="ThumbnailListBox"
                             Grid.Row="4"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="ThumbnailListBox_OnSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="104" Height="76" Margin="0,0,10,0" Background="#ECEEF5" CornerRadius="8" ClipToBounds="True">
                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#36B37E" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusTextBlock" Grid.Column="1" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="准备就绪" />
            <TextBlock Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" Text="API Key 从指定文件按需读取，不会保存到应用配置" />
        </Grid>
    </Grid>
</Window>
