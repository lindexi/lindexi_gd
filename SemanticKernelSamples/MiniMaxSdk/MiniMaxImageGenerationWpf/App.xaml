<Application x:Class="MiniMaxImageGenerationWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="WindowBackgroundColor">#F4F6FB</Color>
        <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
        <Color x:Key="PrimaryColor">#635BFF</Color>
        <Color x:Key="PrimaryHoverColor">#5148E5</Color>
        <Color x:Key="TextPrimaryColor">#172033</Color>
        <Color x:Key="TextSecondaryColor">#687086</Color>
        <Color x:Key="BorderColor">#E2E6F0</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#EEF0F7" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3E6F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="GeneratingText">正在创作图片，请稍候…</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="ReadyText">准备就绪</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="PromptRequiredText">请输入图片描述。</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="ApiKeyFileRequiredText">请输入 MiniMax API Key 文件路径。</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="ApiKeyFileNotFoundText">找不到指定的 MiniMax API Key 文件。</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="ApiKeyFileEmptyText">MiniMax API Key 文件内容为空。</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="ValidationTitle">请检查配置</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="GenerationFailedTitle">图片生成失败</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="GenerationCanceledText">已取消本次生成</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="NoImageReturnedText">服务未返回可预览的图片。</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="SaveFailedTitle">保存图片失败</sys:String>
        <sys:String xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="SavedText">图片已保存</sys:String>
    </Application.Resources>
</Application>
