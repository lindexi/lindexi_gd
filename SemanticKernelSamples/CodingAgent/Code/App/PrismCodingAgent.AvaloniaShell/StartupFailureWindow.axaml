<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
        xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
        x:Class="PrismCodingAgent.AvaloniaShell.StartupFailureWindow"
        x:DataType="vm:StartupFailureViewModel"
        Title="{Binding StartupFailureTitle, Source={x:Static localizations:Lang.Current}}"
        Icon="avares://PrismCodingAgent/Assets/Icons/CodingChatRoom.ico"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="12">
        <TextBlock Grid.Row="0"
                   Text="{Binding StartupFailureTitle, Source={x:Static localizations:Lang.Current}}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource ErrorBrush}" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{Binding ConfigurationFile, Source={x:Static localizations:Lang.Current}}" Classes="Subtitle" />
            <TextBlock Text="{Binding ConfigurationFilePath}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ErrorBrush}" />
        </StackPanel>

        <TextBox Grid.Row="2"
                 Text="{Binding ErrorDetails}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <Button Grid.Row="3"
                Classes="Danger"
                Content="{Binding ExitText, Source={x:Static localizations:Lang.Current}}"
                Command="{Binding ExitCommand}"
                HorizontalAlignment="Right" />
    </Grid>
</Window>
