<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:CodingChatRoom.AvaloniaShell.Converters"
             x:Class="CodingChatRoom.AvaloniaShell.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <converters:WorkspaceTitleConverter x:Key="WorkspaceTitleConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:WindowTransparencyBackgroundConverter x:Key="WindowTransparencyBackgroundConverter" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://CodingAgent/Styles/Strings.axaml" />
        <StyleInclude Source="avares://CodingAgent/Styles/Colors.axaml" />
        <StyleInclude Source="avares://CodingAgent/Styles/Controls.axaml" />
        <StyleInclude Source="avares://CodingAgent/Styles/MessageBubble.axaml" />
        <StyleInclude Source="avares://CodingAgent/Styles/Settings.axaml" />
    </Application.Styles>
</Application>