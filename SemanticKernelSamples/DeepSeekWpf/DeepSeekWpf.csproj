<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeepSeekWpf</AssemblyName>
    <RootNamespace>DeepSeekWpf</RootNamespace>
    <Product>DeepSeekWpf</Product>
    <Description>基于 WPF 的 DeepSeek 智能对话桌面应用。</Description>
    <Authors>DeepSeekWpf Contributors</Authors>
    <Company>DeepSeekWpf Contributors</Company>
    <Copyright>Copyright © DeepSeekWpf Contributors</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <VersionPrefix>1.0.0</VersionPrefix>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".github\**" />
    <Page Remove=".github\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentLib\AgentLib\AgentLib.csproj" />
  </ItemGroup>

</Project>
