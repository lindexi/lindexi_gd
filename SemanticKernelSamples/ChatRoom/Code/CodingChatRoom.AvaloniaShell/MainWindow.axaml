<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CodingChatRoom.AvaloniaShell.ViewModels"
        xmlns:views="using:CodingChatRoom.AvaloniaShell.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="CodingChatRoom.AvaloniaShell.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding ChatViewModel.CommittedWorkspacePath, Converter={StaticResource WorkspaceTitleConverter}, ConverterParameter={StaticResource ApplicationTitle}}"
        Icon="avares://CodingChatRoom.AvaloniaShell/Assets/Icons/CodingChatRoom.ico"
        MinWidth="800"
        MinHeight="520"
        Background="{StaticResource BackgroundBrush}">
    <views:MainView />
</Window>
