<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CodingChatRoom.AvaloniaShell.ViewModels"
        xmlns:views="using:CodingChatRoom.AvaloniaShell.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="CodingChatRoom.AvaloniaShell.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://CodingChatRoom.AvaloniaShell/Assets/Icons/CodingChatRoom.ico"
        Width="1440" Height="900"
        MinWidth="1280"
        MinHeight="720"
        TransparencyLevelHint="Mica, None"
        TransparencyBackgroundFallback="#F3F3F3"
        Background="Transparent">
    <Window.Title>
        <MultiBinding Converter="{StaticResource WorkspaceTitleConverter}"
                      ConverterParameter="{StaticResource ApplicationTitle}">
            <Binding Path="ChatViewModel.NextRunWorkspacePath" />
            <Binding Path="ChatViewModel.CurrentSessionTitle" />
            <Binding Path="ActiveWorkTask.DisplayName" />
        </MultiBinding>
    </Window.Title>
    <views:MainView />
</Window>
