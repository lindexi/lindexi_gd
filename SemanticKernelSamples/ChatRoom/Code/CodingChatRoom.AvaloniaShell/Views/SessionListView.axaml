<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodingChatRoom.AvaloniaShell.ViewModels"
             xmlns:views="using:CodingChatRoom.AvaloniaShell.Views"
             x:Class="CodingChatRoom.AvaloniaShell.Views.SessionListView"
             x:DataType="vm:SessionListViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,0,16,16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{StaticResource SessionListTitle}" Classes="Title" />
            <Button Grid.Column="1" Content="{StaticResource RefreshHistoryText}" Command="{Binding ReloadCommand}" />
        </Grid>
        <TextBox Grid.Row="1" PlaceholderText="{StaticResource HistorySearchText}" Text="{Binding SearchText}" Margin="0,0,0,12" />
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="{StaticResource HistoryLoadingText}" IsVisible="{Binding IsLoading}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="3">
            <TextBlock Text="{StaticResource EmptySessionListText}" Classes="Subtitle"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
            <ListBox ItemsSource="{Binding Sessions}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                        <Border Classes="Card" Padding="12,8" Margin="0,2" DoubleTapped="OnSessionDoubleTapped">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"
                                               ToolTip.Tip="{Binding Title}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsEditing}">
                                        <TextBox Text="{Binding EditedTitle}" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="{StaticResource SaveTitleText}"
                                                Command="{Binding $parent[UserControl].DataContext.SaveTitleCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Content="{StaticResource CancelEditText}"
                                                Command="{Binding $parent[UserControl].DataContext.CancelEditCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                Margin="12,0,0,0" IsVisible="{Binding !IsEditing}">
                                        <Border IsVisible="{Binding IsCurrent}"
                                                Padding="10,4" CornerRadius="6" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource BackgroundBrush}">
                                            <TextBlock Text="{StaticResource CurrentSessionText}" FontWeight="SemiBold" />
                                        </Border>
                                        <Button Classes="Flat" Width="32" Height="32" Padding="7"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{StaticResource EditSessionTitleText}"
                                                AutomationProperties.Name="{StaticResource EditSessionTitleText}"
                                                Command="{Binding $parent[UserControl].DataContext.EditTitleCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Width="16" Height="16" Stretch="Uniform"
                                                  Fill="{StaticResource TextPrimaryBrush}"
                                                  Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="Subtitle" TextTrimming="CharacterEllipsis">
                                            <ToolTip.Tip>
                                                <TextBlock><Run Text="{Binding WorkTaskText}" /><Run Text=" | " /><Run Text="{Binding Subtitle}" /></TextBlock>
                                            </ToolTip.Tip>
                                            <Run Text="{Binding WorkTaskText}" /><Run Text=" | " /><Run Text="{Binding Subtitle}" />
                                        </TextBlock>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="{StaticResource SessionWorkspaceText}" Classes="Subtitle" />
                                            <TextBlock Grid.Column="1" Text="{Binding WorkspacePath}" Classes="Subtitle"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkspacePath}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                        <Button Content="{StaticResource OpenSessionText}"
                                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenSessionCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="Icon Danger" Width="32" Height="32" Padding="7"
                                                ToolTip.Tip="{StaticResource DeleteSessionText}"
                                                AutomationProperties.Name="{StaticResource DeleteSessionText}"
                                                Command="{Binding $parent[UserControl].DataContext.DeleteSessionCommand}" CommandParameter="{Binding}">
                                            <PathIcon Width="16" Height="16"
                                                      Data="M8,3 L16,3 L17,5 L21,5 L21,7 L19,7 L18,21 L6,21 L5,7 L3,7 L3,5 L7,5 Z M8,7 L9,19 L15,19 L16,7 Z M10,9 L12,9 L12,17 L10,17 Z M14,9 L16,9 L16,17 L14,17 Z" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
