<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CodingChatRoom.AvaloniaShell.ViewModels"
             xmlns:model="using:AgentLib.Model"
             xmlns:views="using:CodingChatRoom.AvaloniaShell.Views"
             x:Class="CodingChatRoom.AvaloniaShell.Views.ChatView"
             x:DataType="vm:ChatViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="AssistantTextItemTemplate" x:DataType="model:CopilotChatTextItem">
            <TextBox Classes="ChatOutput"
                     Margin="0,0,0,8"
                     Text="{Binding Text}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     IsVisible="{Binding HasText}" />
        </DataTemplate>

        <DataTemplate x:Key="UserTextItemTemplate" x:DataType="model:CopilotChatTextItem">
            <TextBox Classes="ChatOutput UserChatOutput"
                     Margin="0,0,0,8"
                     Text="{Binding Text}"
                     IsVisible="{Binding HasText}" />
        </DataTemplate>

        <DataTemplate x:Key="ImageItemTemplate" x:DataType="model:CopilotChatImageItem">
            <Button Margin="0,0,0,8"
                    Padding="0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip.Tip="{StaticResource OpenImageExternallyText}"
                    CommandParameter="{Binding}"
                    Click="ImageButton_OnClick">
                <views:BinaryImage Width="240"
                                   Height="180"
                                   Data="{Binding Data}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="AssistantReasoningItemTemplate" x:DataType="model:CopilotChatReasoningItem">
            <Expander Classes="ReasoningExpander"
                      Margin="0,0,0,8"
                      IsExpanded="False"
                      IsVisible="{Binding HasText}">
                <Expander.Header>
                    <TextBlock Text="思考过程"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF546E7A" />
                </Expander.Header>
                <Border Classes="ReasoningPanel">
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               Foreground="#FF546E7A" />
                </Border>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="AssistantToolItemTemplate" x:DataType="model:CopilotChatToolItem">
            <Expander Margin="0,0,0,8">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8"
                          ToolTip.Tip="{Binding ToolTipText}">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PrimaryText}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasPrimaryText}" />
                        <TextBlock Grid.Column="2"
                                   MaxWidth="240"
                                   Text="{Binding SecondaryText}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsVisible="{Binding HasSecondaryText}" />
                    </Grid>
                </Expander.Header>
                <Border Classes="ToolPanel">
                    <StackPanel Spacing="6">
                        <StackPanel IsVisible="{Binding HasInputText}">
                            <TextBlock Classes="SecondaryLabel" Text="{StaticResource ToolInputText}" />
                            <TextBox Classes="ChatOutput" Text="{Binding InputText}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HasOutputText}">
                            <TextBlock Classes="SecondaryLabel" Text="{StaticResource ToolOutputText}" />
                            <TextBox Classes="ChatOutput" Text="{Binding OutputText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="AssistantApprovalToolItemTemplate" x:DataType="model:CopilotChatApprovalToolItem">
            <Border Classes="ApprovalPanel" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="SecondaryLabel" Text="{Binding ApprovalStateText}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasApprovalDescription}">
                        <TextBlock Classes="SecondaryLabel" Text="审批说明" />
                        <TextBox Classes="ChatOutput" Text="{Binding ApprovalDescription}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasInputText}">
                        <TextBlock Classes="SecondaryLabel" Text="输入参数" />
                        <TextBox Classes="ChatOutput" Text="{Binding InputText}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasOutputText}">
                        <TextBlock Classes="SecondaryLabel" Text="工具输出" />
                        <TextBox Classes="ChatOutput" Text="{Binding OutputText}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding HasDecisionReason}">
                        <TextBlock Classes="SecondaryLabel" Text="拒绝原因" />
                        <TextBox Classes="ChatOutput" Text="{Binding DecisionReason}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding CanRespondToApproval}">
                        <Button Classes="Primary accent"
                                Content="同意"
                                Click="ApproveToolButton_OnClick"
                                CommandParameter="{Binding}" />
                        <Button Classes="Danger"
                                Content="拒绝"
                                Click="RejectToolButton_OnClick"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantSubAgentItemTemplate" x:DataType="model:CopilotChatSubAgentItem">
            <Expander Margin="0,0,0,8" IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="{Binding DisplayName}" />
                </Expander.Header>
                <Border Classes="SubAgentPanel">
                    <StackPanel Spacing="6">
                        <StackPanel IsVisible="{Binding HasInputText}">
                            <TextBlock Classes="SecondaryLabel" Text="任务输入" />
                            <TextBox Classes="ChatOutput" Text="{Binding InputText}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MessageItems}"
                                      ItemTemplate="{StaticResource ChatMessageItemTemplateSelector}"
                                      IsVisible="{Binding HasMessageItems}" />
                        <StackPanel IsVisible="{Binding HasOutputText}">
                            <TextBlock Classes="SecondaryLabel" Text="返回上级代理的输出" />
                            <TextBox Classes="ChatOutput" Text="{Binding OutputText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>

        <views:ChatMessageItemTemplateSelector x:Key="ChatMessageItemTemplateSelector"
                                               TextItemTemplate="{StaticResource AssistantTextItemTemplate}"
                                               ReasoningItemTemplate="{StaticResource AssistantReasoningItemTemplate}"
                                               ImageItemTemplate="{StaticResource ImageItemTemplate}"
                                               ToolItemTemplate="{StaticResource AssistantToolItemTemplate}"
                                               ApprovalToolItemTemplate="{StaticResource AssistantApprovalToolItemTemplate}"
                                               SubAgentItemTemplate="{StaticResource AssistantSubAgentItemTemplate}" />
        <views:ChatMessageItemTemplateSelector x:Key="UserMessageItemTemplateSelector"
                                               TextItemTemplate="{StaticResource UserTextItemTemplate}"
                                               ImageItemTemplate="{StaticResource ImageItemTemplate}" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource BackgroundBrush}">
        <Border Grid.Row="0"
                Margin="32,12,32,8" Padding="16,12"
                CornerRadius="8" Background="#B3FFFFFF"
                BorderBrush="#10000000" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,72" RowDefinitions="Auto,Auto" RowSpacing="7"
                  ColumnSpacing="16">
                <TextBlock Text="{StaticResource WorkDirectoryText}" Classes="Subtitle" FontSize="11" />
                <Grid Grid.Column="1" ColumnDefinitions="220,96" ColumnSpacing="8">
                    <TextBlock Text="{StaticResource ModelText}" Classes="Subtitle" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{StaticResource ReasoningEffortText}" Classes="Subtitle" FontSize="11" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             MinHeight="32"
                             Classes="Rounded"
                             ToolTip.Tip="{Binding WorkspaceStatusText}"
                             Text="{Binding WorkspaceInput, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{StaticResource WorkspacePlaceholderText}"
                             IsEnabled="{Binding !IsChangingWorkspace}" />
                    <Button Grid.Column="1"
                            MinWidth="72"
                            MinHeight="32"
                            Classes="Primary accent"
                            Content="应用"
                            Command="{Binding ApplyWorkspaceCommand}"
                            IsEnabled="{Binding CanApplyWorkspace}" />
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <ComboBox x:Name="ModelSelector"
                              Width="220"
                              MinHeight="32"
                              ToolTip.Tip="选择语言模型"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding !IsRunning}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageModelOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox x:Name="ReasoningEffortSelector"
                              Width="96"
                              MinHeight="32"
                              ToolTip.Tip="{StaticResource ReasoningEffortToolTip}"
                              ItemsSource="{Binding AvailableReasoningEfforts}"
                              SelectedItem="{Binding SelectedReasoningEffort}"
                              IsEnabled="{Binding !IsRunning}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReasoningEffortOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="TaskHistoryButton" Classes="Secondary" Width="32" Height="32" Padding="7"
                            ToolTip.Tip="{StaticResource SessionListTitle}" AutomationProperties.Name="{StaticResource SessionListTitle}"
                            Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenTaskHistoryCommand}">
                        <PathIcon Width="16" Height="16" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 M11,6 L13,6 L13,12 L17,14 L16,16 L11,13 Z" />
                    </Button>
                    <Button x:Name="OpenLogDirectoryButton" Classes="Secondary" Width="32" Height="32" Padding="7"
                            ToolTip.Tip="{StaticResource OpenLogDirectoryText}" AutomationProperties.Name="{StaticResource OpenLogDirectoryText}"
                            Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenLogDirectoryCommand}">
                        <PathIcon Width="16" Height="16" Data="M5,2 L15,2 L20,7 L20,22 L5,22 Z M15,4 L15,8 L19,8 Z M8,11 L17,11 L17,13 L8,13 Z M8,15 L17,15 L17,17 L8,17 Z M8,19 L14,19 L14,21 L8,21 Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="32" IsVisible="{Binding ShowWelcome}">
            <Border Width="52" Height="52" CornerRadius="16" Background="#E6EDFC" HorizontalAlignment="Center">
                <PathIcon Width="26" Height="26" Foreground="#4969B8" Data="M4,4 L20,4 L20,18 L13,18 L8,22 L8,18 L4,18 Z M6,6 L6,16 L10,16 L10,18 L12,16 L18,16 L18,6 Z" />
            </Border>
            <TextBlock Text="{StaticResource WelcomeTitleText}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{StaticResource WelcomeDescriptionText}" Classes="Subtitle" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock Text="{StaticResource WelcomeExamplesText}" Classes="Subtitle" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
        <ScrollViewer x:Name="MessagesScrollViewer" IsVisible="{Binding !ShowWelcome}"
                      Grid.Row="1"
                      Background="{StaticResource BackgroundBrush}"
                      Padding="32,0,16,0"
                      AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesItemsControl" HorizontalAlignment="Stretch" ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItemViewModel">
                        <Grid Margin="0,0,0,24">
                            <StackPanel HorizontalAlignment="Stretch"
                                        Spacing="10"
                                        IsVisible="{Binding IsAssistantMessage}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="#E6EDFC"><PathIcon Width="16" Height="16" Foreground="#4969B8" Data="M8,3 L8,1 L10,1 L10,3 L14,3 L14,1 L16,1 L16,3 L20,3 L20,7 L23,7 L23,9 L20,9 L20,15 L23,15 L23,17 L20,17 L20,21 L4,21 L4,17 L1,17 L1,15 L4,15 L4,9 L1,9 L1,7 L4,7 L4,3 Z M6,5 L6,19 L18,19 L18,5 Z M8,9 L10,9 L10,12 L8,12 Z M14,9 L16,9 L16,12 L14,12 Z M8,15 L16,15 L16,17 L8,17 Z" /></Border>
                                    <TextBlock Text="{Binding Author}" Classes="AuthorName" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TimeText}" Classes="Timestamp" />
                                </StackPanel>
                                <Border Classes="MessageBubbleAssistant" HorizontalAlignment="Stretch">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制正文"
                                                      Click="CopyContentMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="复制整条"
                                                      Click="CopyFullMessageMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ItemsControl ItemsSource="{Binding MessageItems}"
                                                  ItemTemplate="{StaticResource ChatMessageItemTemplateSelector}" />
                                </Border>
                                <Border Classes="UsageSummaryBorder"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding HasUsageDetails}">
                                    <TextBlock Classes="UsageSummaryText"
                                               Text="{Binding UsageSummaryText}"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right"
                                        MaxWidth="720"
                                        Spacing="2"
                                        IsVisible="{Binding IsUserMessage}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <TextBlock Text="{Binding TimeText}" Classes="Timestamp" />
                                    <TextBlock Text="{Binding Author}" Classes="AuthorName" />
                                </StackPanel>
                                <Border Classes="MessageBubbleUser" HorizontalAlignment="Right">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制正文"
                                                      Click="CopyContentMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="复制整条"
                                                      Click="CopyFullMessageMenuItem_OnClick"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ItemsControl ItemsSource="{Binding MessageItems}"
                                                  ItemTemplate="{StaticResource UserMessageItemTemplateSelector}" />
                                </Border>
                            </StackPanel>

                            <Border Classes="MessageBubbleSystem"
                                    HorizontalAlignment="Center"
                                    MaxWidth="520"
                                    IsVisible="{Binding IsSystemMessage}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制正文"
                                                  Click="CopyContentMenuItem_OnClick"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="复制整条"
                                                  Click="CopyFullMessageMenuItem_OnClick"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock Text="{Binding Content}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="32,8,32,18" RowDefinitions="Auto,Auto" RowSpacing="8">
          <Border x:Name="ComposerPanel" Classes="ComposerSurface" Padding="16,14,16,10" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8">
                <ItemsControl Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              Margin="0,0,0,8"
                              ItemsSource="{Binding PendingImages}"
                              IsVisible="{Binding HasPendingImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageAttachmentViewModel">
                                <Border Margin="0,0,8,8"
                                        Padding="4"
                                        Background="{StaticResource SurfaceVariantBrush}"
                                        CornerRadius="6">
                                    <Grid>
                                        <views:BinaryImage Width="96"
                                                           Height="72"
                                                           Data="{Binding Data}"
                                                           ToolTip.Tip="{Binding FileName}" />
                                        <Button Width="24"
                                                Height="24"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="0"
                                                Content="×"
                                                ToolTip.Tip="{StaticResource RemoveImageText}"
                                                Click="RemoveImageButton_OnClick"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="AbilitySelector"
                              MinWidth="150"
                              ItemsSource="{Binding AvailableAbilities}"
                              SelectedItem="{Binding SelectedAbility}"
                              DropDownOpened="AbilitySelector_OnDropDownOpened">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AbilityOptionViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="Secondary"
                            Content="{StaticResource AddImageText}"
                            Click="AddImageButton_OnClick" />
                </StackPanel>
                <TextBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="MessageInputTextBox"
                         Classes="ComposerInput" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{StaticResource MessageInputPlaceholder}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{StaticResource InputShortcutText}"
                           Classes="Subtitle" Margin="12,0" VerticalAlignment="Center" IsVisible="{Binding !IsRunning}" />
                <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Classes="Danger" Content="{StaticResource StopText}"
                        Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
                <Button Grid.Row="2" Grid.Column="2" x:Name="SendButton" Classes="Primary accent" MinWidth="88"
                        Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="14" Height="14" Data="M2,3 L22,12 L2,21 L6,13 L15,12 L6,11 Z" /><TextBlock Text="{Binding SendButtonText}" /></StackPanel>
                </Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox x:Name="LoopIterationCheckBox" Content="{StaticResource LoopIterationText}" IsChecked="{Binding IsLoopIterationEnabled}" />
              <CheckBox x:Name="AutomaticCompressionCheckBox" Content="{StaticResource AutomaticCompressionText}" IsChecked="{Binding IsAutomaticCompressionEnabled}" />
              <CheckBox x:Name="EnableDotNetRunCheckBox" Content="{StaticResource EnableDotNetRunText}" IsChecked="{Binding IsDotNetRunEnabled}" ToolTip.Tip="{StaticResource EnableDotNetRunToolTip}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button x:Name="CompressConversationButton" Classes="Secondary" Content="{StaticResource CompressConversationText}" Command="{Binding CompressConversationCommand}" IsEnabled="{Binding CanCompressConversation}" />
              <Button x:Name="StopLanguageServerButton" Classes="Secondary" Content="{StaticResource StopLanguageServerText}" Command="{Binding StopLanguageServerCommand}" ToolTip.Tip="{StaticResource StopLanguageServerToolTip}" />
              <Button x:Name="NewSessionButton" Classes="Secondary" Content="{StaticResource NewSessionText}"
                      Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).SessionListViewModel.CreateNewSessionCommand}" />
            </StackPanel>
          </Grid>
        </Grid>
    </Grid>
</UserControl>
