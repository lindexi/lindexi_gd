{
  "TokenizerPath": "../minimind_model/tokenizer.json",
  "TokenizerConfigPath": "../minimind_model/tokenizer_config.json",
  "DatasetPath": "../minimind_dataset/pretrain_t2t_mini.jsonl",
  "DatasetFormat": "pretrain",
  "ArchiveRoot": "artifacts/smoke-runs",
