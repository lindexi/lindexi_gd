  "Partition": { "StructureSelectionFraction": 0.25, "TestFraction": 0.25, "Seed": 7 },
  "Controller": { "ObservationUpdates": 2, "LearningRate": 0.01, "CostPerNode": 0.001, "BaselineRate": 0.1, "UseNodeFeatures": true },
  "Archive": { "SaveEveryUpdates": 10, "SaveEverySeconds": 600, "SaveTimeoutSeconds": 120, "MaxCheckpoints": 100 },
  "Sampling": { "Temperature": 1, "RepetitionPenalty": 1, "TopK": 20, "TopP": 0.9, "DoSample": true }
