<Window x:Class="MathGraph.ReversibleFractal.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MathGraph.ReversibleFractal.Wpf" Title="{StaticResource Title}" Width="1380" Height="900" MinWidth="1000" MinHeight="700" FontFamily="Microsoft YaHei UI" Background="#F2F6FC">
  <Grid Margin="10">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#CBD9EB" BorderThickness="1" Margin="0,0,10,0"><Grid>
      <local:GraphView x:Name="Graph" AutomationProperties.Name="{StaticResource Hint}"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"><Button Content="{StaticResource ZoomIn}" Click="ZoomInClick"/><Button Content="{StaticResource ZoomOut}" Click="ZoomOutClick"/><Button Content="{StaticResource Fit}" Click="FitClick"/></StackPanel>
    </Grid></Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,0">
      <Button Content="{StaticResource ExampleC}" Click="ExampleCClick"/><Button Content="{StaticResource ExampleA}" Click="ExampleAClick"/><Button Content="{StaticResource CollapseAll}" Click="CollapseAllClick"/>
      <TextBlock Text="{StaticResource Depth}" Margin="0,10,0,4"/>
      <TextBox x:Name="Levels" Text="1" AutomationProperties.Name="{StaticResource Depth}" Margin="0,0,0,6"/>
      <Button Content="{StaticResource Generate}" Click="GenerateClick"/>
      <Border Background="#E3EEFC" Padding="8" Margin="0,10"><TextBlock x:Name="Stats" TextWrapping="Wrap"/></Border>
      <TextBlock Text="{StaticResource Modules}"/><ComboBox x:Name="Modules" SelectionChanged="ModuleChanged" Margin="0,6"/><Button Content="{StaticResource Collapse}" Click="CollapseClick"/>
      <TextBlock x:Name="Selection" TextWrapping="Wrap" Margin="0,6"/><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#A33D16" Margin="0,6"/>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
