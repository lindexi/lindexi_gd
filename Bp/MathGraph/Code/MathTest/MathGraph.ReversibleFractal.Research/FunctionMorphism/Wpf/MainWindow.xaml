<Window x:Class="MathGraph.FunctionMorphism.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="五点展开 · 端口检查" Width="920" Height="430" MinWidth="460" MinHeight="360">
    <Window.Resources>
        <sys:String x:Key="InvalidInput">请输入有效的有符号十进制整数。</sys:String>
        <sys:String x:Key="ForwardFormula">示例算子：f(x, y) = x² − y</sys:String>
        <sys:String x:Key="ReverseFormula">示例算子：g(t) = (t² + 1, t³ − t)</sys:String>
        <sys:String x:Key="CopyOperator">复制：t → (t, t)</sys:String>
        <sys:String x:Key="FirstOperator">取第 0 路：(u, v) → u</sys:String>
        <sys:String x:Key="SecondOperator">取第 1 路：(u, v) → v</sys:String>
        <sys:String x:Key="ForwardOperator">f(x, y) = x² − y</sys:String>
        <sys:String x:Key="ReverseOperator">g(t) = (t² + 1, t³ − t)</sys:String>
        <sys:String x:Key="OutputComparison">输出 {0}：展开前 {1}，展开后 {2}，绝对误差 {3}</sys:String>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MinWidth="660">
            <TextBlock Text="五点展开" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,12" Text="反向指模板接线方向，不表示求逆。端口从 0 编号。" />
            <StackPanel Orientation="Horizontal">
                <Label Content="模板" Target="{Binding ElementName=TemplateSelector}" />
                <ComboBox x:Name="TemplateSelector" Width="130" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="正向 · 2 → 1" />
                    <ComboBoxItem Content="反向 · 1 → 2" />
                </ComboBox>
                <Label Content="输入 0" Target="{Binding ElementName=FirstInput}" />
                <TextBox x:Name="FirstInput" Text="2" MaxLength="40" Width="110" VerticalContentAlignment="Center" />
                <StackPanel x:Name="SecondInputGroup" Orientation="Horizontal">
                    <Label Content="输入 1" Target="{Binding ElementName=SecondInput}" />
                    <TextBox x:Name="SecondInput" Text="-3" MaxLength="40" Width="110" VerticalContentAlignment="Center" />
                </StackPanel>
                <TextBlock Text="编辑后自动更新" Foreground="DimGray" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Formula" Margin="0,8,0,0" />
            <TextBlock x:Name="Status" Foreground="Firebrick" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
            <StackPanel x:Name="Results">
                <TextBlock x:Name="OutputSummary" Margin="0,12,0,0" />
                <TextBlock Text="展开后的模板（左侧蓝点为输入，右侧绿点为输出）" FontWeight="SemiBold" Margin="0,12,0,4" />
                <Border BorderBrush="LightGray" BorderThickness="1" Background="White">
                    <Canvas x:Name="Graph" Height="200" HorizontalAlignment="Left"
                            AutomationProperties.Name="五点模板、节点算子、端口值和连线传值" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
