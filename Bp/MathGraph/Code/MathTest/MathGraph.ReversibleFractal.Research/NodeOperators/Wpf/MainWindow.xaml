<Window x:Class="MathGraph.NodeOperators.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="节点算子 · 前向与反传" Width="900" Height="700" MinWidth="570" MinHeight="420">
    <Window.Resources>
        <sys:String x:Key="BaseTopology">基础 · 不展开</sys:String>
        <sys:String x:Key="ForwardTopology">正向展开 · C</sys:String>
        <sys:String x:Key="ReverseTopology">反向展开 · A</sys:String>
        <sys:String x:Key="MixedTopology">混合展开 · A + C</sys:String>
        <sys:String x:Key="MixedActivation">混合 · Identity / Tanh</sys:String>
        <sys:String x:Key="InvalidInput">请输入两个有限数值。当前小数分隔符为“{0}”。</sys:String>
        <sys:String x:Key="NonFiniteResult">计算结果包含非有限数值，请减小输入的绝对值。</sys:String>
        <sys:String x:Key="OutputTitle">前向输出</sys:String>
        <sys:String x:Key="InputTitle">输入梯度</sys:String>
        <sys:String x:Key="ParameterTitle">参数梯度 · 核心参数顺序</sys:String>
        <sys:String x:Key="GraphSummary">叶节点：{0}，参数：{1}</sys:String>
        <sys:String x:Key="ChartTitle">{0}（最大绝对值：{1:G8}）</sys:String>
        <DataTemplate x:Key="BarRow">
            <Grid Margin="0,2" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                <Grid Grid.Column="1" Background="#FFF1F5F9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.ColumnSpan="2" Stretch="Fill" Height="14">
                        <Grid Width="200" Height="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="{Binding NegativeWidth}" HorizontalAlignment="Right" Fill="#FFB45309" />
                            <Rectangle Grid.Column="1" Width="{Binding PositiveWidth}" HorizontalAlignment="Left" Fill="#FF0369A1" />
                        </Grid>
                    </Viewbox>
                    <Border BorderBrush="#FF64748B" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding Value, StringFormat=G8}" VerticalAlignment="Center">
                    <TextBlock.ToolTip>
                        <TextBlock Text="{Binding Value, StringFormat=G17}" />
                    </TextBlock.ToolTip>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="18" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="FullCross 节点算子" FontSize="24" FontWeight="SemiBold" />
            <WrapPanel Margin="0,10,0,4">
                <Label Content="拓扑" Target="{Binding ElementName=TopologyBox}" />
                <ComboBox x:Name="TopologyBox" Width="145" DisplayMemberPath="Label" />
                <Label Content="激活" Target="{Binding ElementName=ActivationBox}" />
                <ComboBox x:Name="ActivationBox" Width="145" DisplayMemberPath="Label" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,4">
                <Label Content="x[0]" Target="{Binding ElementName=FirstInput}" />
                <TextBox x:Name="FirstInput" Width="92" VerticalContentAlignment="Center" />
                <Label Content="x[1]" Target="{Binding ElementName=SecondInput}" />
                <TextBox x:Name="SecondInput" Width="92" VerticalContentAlignment="Center" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="修改后自动计算" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,5,0,4" TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,12" Foreground="#FF475569" TextWrapping="Wrap"
                       Text="目标 L = y[0]（输出种子 1）。零线左侧为负，右侧为正；各组以本组最大绝对值为满刻度，跨组请比较数值。" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ResultsPanel">
                <GroupBox x:Name="OutputGroup">
                    <ItemsControl x:Name="OutputRows" ItemTemplate="{StaticResource BarRow}" />
                </GroupBox>
                <GroupBox x:Name="InputGroup">
                    <ItemsControl x:Name="InputRows" ItemTemplate="{StaticResource BarRow}" />
                </GroupBox>
                <GroupBox x:Name="ParameterGroup">
                    <ItemsControl x:Name="ParameterRows" ItemTemplate="{StaticResource BarRow}" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
