<Window x:Class="MathGraph.DiamondFractal.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MathGraph.DiamondFractal.Wpf" Title="{StaticResource Title}" Width="1360" Height="880" MinWidth="1000" MinHeight="700" Background="#F2F6FC" FontFamily="Microsoft YaHei UI">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{StaticResource Title}" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#CBD9EB" BorderThickness="1" Background="White" Margin="0,0,20,0">
        <Grid><local:GraphView x:Name="Graph" AutomationProperties.Name="{StaticResource Hint}"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12">
            <Button Content="{StaticResource ZoomIn}" Click="ZoomInClick"/>
            <Button Content="{StaticResource ZoomOut}" Click="ZoomOutClick"/>
            <Button Content="{StaticResource Fit}" Click="FitClick"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <WrapPanel><Button Content="{StaticResource Reset}" Click="ResetClick"/><Button Content="{StaticResource CollapseAll}" Click="CollapseAllClick"/></WrapPanel>
          <TextBlock Text="{StaticResource Depth}" Margin="0,16,0,5"/>
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DepthSlider, Path=Value}" Width="24"/><Slider x:Name="DepthSlider" Minimum="0" Maximum="6" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="{StaticResource Depth}"/></DockPanel>
          <ComboBox x:Name="Mode" SelectedIndex="0" Margin="0,10,0,8" Padding="5" AutomationProperties.Name="{StaticResource Generate}"><ComboBoxItem Content="{StaticResource Upper}"/><ComboBoxItem Content="{StaticResource Both}"/></ComboBox>
          <TextBlock Text="{StaticResource Budget}" Margin="0,6,0,4"/>
          <TextBox x:Name="Budget" Text="126" Padding="5" AutomationProperties.Name="{StaticResource Budget}"/>
          <Button Content="{StaticResource Generate}" Click="GenerateClick"/>
          <Border Background="#E3EEFC" Padding="12" Margin="0,16,0,14"><TextBlock x:Name="Statistics" LineHeight="25" TextWrapping="Wrap"/></Border>
          <TextBlock Text="{StaticResource Modules}" Margin="0,0,0,8"/>
          <ComboBox x:Name="Modules" SelectionChanged="ModuleChanged" Padding="5" AutomationProperties.Name="{StaticResource Modules}"/>
          <Button Content="{StaticResource Collapse}" Click="CollapseClick"/>
          <TextBlock x:Name="SelectionInfo" TextWrapping="Wrap" Margin="0,8,0,12"/>
          <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#A33D16" Margin="0,0,0,10"/>
          <TextBlock Text="{StaticResource Rules}" TextWrapping="Wrap" FontSize="13" LineHeight="22"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="2" Text="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/>
  </Grid>
</Window>
