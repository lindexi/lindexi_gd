<Application x:Class="PptxGenerator.Chat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <s:String x:Key="AppTitle">课件聊天</s:String>
        <s:String x:Key="HistoryTitle">历史会话</s:String>
        <s:String x:Key="NewSession">新建会话</s:String>
        <s:String x:Key="HistoryBack">返回聊天</s:String>
        <s:String x:Key="HistorySearch">搜索会话标题</s:String>
        <s:String x:Key="HistoryEmpty">没有匹配的会话。</s:String>
        <s:String x:Key="HistoryLoading">正在读取会话…</s:String>
        <s:String x:Key="HistorySkipped">有 {0} 个会话无法读取，已跳过。</s:String>
        <s:String x:Key="HistoryReadFailed">无法读取会话，请检查本地会话目录后重试。</s:String>
        <s:String x:Key="HistorySaveFailed">未能保存本轮会话，请检查本地会话目录。</s:String>
        <s:String x:Key="ConfigTitle">会话配置</s:String>
        <s:String x:Key="ModelLabel">模型</s:String>
        <s:String x:Key="WorkLabel">工作路径</s:String>
        <s:String x:Key="McpLabel">MCP 地址</s:String>
        <s:String x:Key="WelcomeTitle">今天想做什么课件？</s:String>
        <s:String x:Key="WelcomeHint">告诉我你要讲什么，我可以帮你制作课件页面，也可以一起修改已有课件的内容和排版。</s:String>
        <s:String x:Key="WelcomeMcpFailed">连接 mcp 失败，请先启动云课件</s:String>
        <s:String x:Key="ToolCoursewareInfo">获取课件信息</s:String>
        <s:String x:Key="DraftHint">输入消息，或添加图片…</s:String>
        <s:String x:Key="Send">发送</s:String>
        <s:String x:Key="Stop">停止</s:String>
        <s:String x:Key="Attach">添加图片</s:String>
        <s:String x:Key="Remove">移除图片</s:String>
        <s:String x:Key="Copy">复制</s:String>
        <s:String x:Key="Copied">已复制正文。</s:String>
        <s:String x:Key="CopyFailed">剪贴板暂不可用，请稍后再试。</s:String>
        <s:String x:Key="KeyboardHint">Ctrl + Enter 发送</s:String>
        <s:String x:Key="ImageFilter">图片|*.png;*.jpg;*.jpeg;*.webp;*.gif</s:String>
        <s:String x:Key="ImagePickerFailed">无法打开图片选择窗口，请重试。</s:String>
        <s:String x:Key="ImageFormat">请选择 PNG、JPEG、WebP 或 GIF 图片。</s:String>
        <s:String x:Key="ImageFailed">无法读取「{0}」，请检查文件后重试。</s:String>
        <s:String x:Key="NoModels">配置中没有可用的 Responses 模型。</s:String>
        <s:String x:Key="SelectModel">主模型不可用或无法唯一匹配，请选择模型。</s:String>
        <s:String x:Key="ConfigMissing">未找到模型配置文件：{0}</s:String>
        <s:String x:Key="ConfigDenied">没有权限读取模型配置文件：{0}</s:String>
        <s:String x:Key="ConfigInvalid">模型配置格式无效，请检查：{0}</s:String>
        <s:String x:Key="ConfigIo">无法读取模型配置文件，请检查文件是否可用：{0}</s:String>
        <s:String x:Key="WorkPathInvalid">工作路径不可用。本轮不使用本地文件工具，请检查目录后重试。</s:String>
        <s:String x:Key="McpInvalid">请输入有效的 HTTP 或 HTTPS 地址；留空可禁用 MCP。</s:String>
        <s:String x:Key="McpUnavailable">未能连接课件工具，请检查 MCP 服务和地址。仍可继续聊天。</s:String>
        <s:String x:Key="McpOutcomeUnknown">未收到课件工具的结果。请先查看课件，确认操作是否已生效。</s:String>
        <s:String x:Key="UserRole">你</s:String>
        <s:String x:Key="AssistantRole">助手</s:String>
        <s:String x:Key="ReplyWaiting">正在等待回复…</s:String>
        <s:String x:Key="ReplyStopped">已停止。已经完成的操作不会撤销。</s:String>
        <s:String x:Key="ReplyIncomplete">模型未能完整回复，已保留收到的内容。</s:String>
        <s:String x:Key="ReplyEmpty">模型未返回正文。</s:String>
        <s:String x:Key="ReplyUnauthorized">模型服务拒绝了请求，请检查模型配置中的凭据及权限。</s:String>
        <s:String x:Key="ReplyFailed">未能完成回复。请检查模型连接后重试。</s:String>
        <s:String x:Key="UsageSummary">本轮 {0:N0} Token · 输入 {1:N0} · 输出 {2:N0}</s:String>
        <s:String x:Key="UsageReasoning"> · 推理 {0}</s:String>
        <s:String x:Key="UsageCached"> · 缓存命中 {0}</s:String>
        <s:String x:Key="PriorImage">[用户添加了图片]</s:String>
        <s:String x:Key="ToolPending">等待执行</s:String>
        <s:String x:Key="ToolRunning">执行中</s:String>
        <s:String x:Key="ToolReturned">已返回</s:String>
        <s:String x:Key="ToolError">调用失败</s:String>
        <s:String x:Key="ToolUnknown">结果待确认</s:String>
        <s:String x:Key="ToolStopped">已停止</s:String>
        <s:String x:Key="ToolSkipped">未执行</s:String>
        <s:String x:Key="ToolArguments">调用参数</s:String>
        <s:String x:Key="ToolResult">返回结果</s:String>
        <s:String x:Key="OpenToolImage">在系统图片查看器中打开</s:String>
        <s:String x:Key="OpenToolImageFailed">无法打开图片。请检查临时目录和 Windows 默认图片应用后重试。</s:String>
        <s:String x:Key="ToolImageUnavailable">已收到图片，但无法预览。</s:String>
        <s:String x:Key="ToolUnavailable">工具未能完成请求。</s:String>
        <s:String x:Key="ToolRead">读取文本文件</s:String>
        <s:String x:Key="ToolWrite">写入文本文件</s:String>
        <s:String x:Key="ToolRender">更新 SlideML</s:String>
        <s:String x:Key="ToolSlide">查看页面信息</s:String>
        <s:String x:Key="ToolScreenshot">获取页面截图</s:String>
        <s:String x:Key="ToolResource">注册课件资源</s:String>
        <s:String x:Key="ToolExport">导出课件 Markdown</s:String>
        <s:String x:Key="Instructions">你是课件聊天助手。直接回答普通问题，按任务需要使用工具。按工具实际结果汇报，不声称完成未执行的操作。</s:String>
        <s:String x:Key="ToolReadSkill">读取课件技能</s:String>
        <s:String x:Key="SkillReadFailed">无法读取课件技能文档，请使用 SKILL.md 或入口中列出的 references/ 相对路径。</s:String>
        <s:String x:Key="SkillLoadFailed">本轮无法加载课件技能，仍可继续聊天。</s:String>

        <BooleanToVisibilityConverter x:Key="Visible" />
        <SolidColorBrush x:Key="Ink" Color="#222222" />
        <SolidColorBrush x:Key="Muted" Color="#626262" />
        <SolidColorBrush x:Key="Stroke" Color="#DADADA" />
        <SolidColorBrush x:Key="Surface" Color="#F9FFFFFF" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F4F4F4" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
