<UserControl x:Class="CoursewarePptxGeneratorWpfDemo.Views.CopilotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CoursewarePptxGeneratorWpfDemo.Views.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:CoursewarePptxGeneratorWpfDemo.ViewModels"
             xmlns:views="clr-namespace:CoursewarePptxGeneratorWpfDemo.Views"
             Background="{StaticResource LightBackgroundBrush}"
             d:DataContext="{d:DesignInstance Type=viewModels:CoursewareSlideWorkspaceViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="760"
             d:DesignWidth="420"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{StaticResource PageAssistantTitleText}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectedSlide.Title}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock Text="{StaticResource GenerationModelText}"
                               Margin="2,0,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <ComboBox Width="220"
                              AutomationProperties.Name="{StaticResource GenerationModelToolTipText}"
                              ToolTip="{StaticResource GenerationModelToolTipText}"
                              Style="{DynamicResource ModelSelectorComboBoxStyle}"
                              ItemsSource="{Binding SelectedSlide.AvailableModelItems}"
                              SelectedItem="{Binding SelectedSlide.SelectedModelItem, Mode=TwoWay}"
                              IsEnabled="{Binding SelectedSlide.IsAiGenerationAvailable}"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBlock Text="{Binding SelectedSlide.ScreenshotAttachmentStatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <TextBlock Text="{StaticResource ImageAttachmentUsageHintText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
                <TextBlock Text="{Binding SelectedSlide.RuntimeStatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <views:CopilotMessageStream Grid.Row="2"
                                    ItemsSource="{Binding SelectedSlide.CopilotChatManager.ChatMessages}"
                                    ListBackground="White" />

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <ItemsControl x:Name="AttachedImageFilesItemsControl"
                              ItemsSource="{Binding SelectedSlide.AttachedImageFiles}" DockPanel.Dock="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:CoursewareChatImageAttachmentViewModel}">
                            <Border CornerRadius="8" Width="64" Height="64" Margin="0,0,8,0" Background="#FFF1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding FullName, Converter={x:Static converters:FilePathToImageSourceConverter.Instance}}" Stretch="UniformToFill" Width="64" Height="64" />
                                    <Button Content="✕"
                                            ToolTip="{StaticResource RemoveImageAttachmentText}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibility}}"
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#CC444444"
                                            Foreground="White"
                                            FontSize="9"
                                            Padding="0"
                                            Click="CloseAttachedImageButton_OnClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{StaticResource AddImageText}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Left"
                        MinWidth="88"
                        Height="36"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6"
                        Click="AttachImageButton_OnClick" />
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Expander FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource AdvancedRenderingSettingsTitleText}" />
                        <TextBlock Text=" - " />
                        <TextBlock Text="{Binding McpStatusText}" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{StaticResource AdvancedRenderingSettingsDescriptionText}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Row="0"
                             Grid.Column="0"
                             Text="{Binding McpServiceUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SingleLineInputTextBoxStyle}"
                             ToolTip="{StaticResource RemoteRenderingServiceAddressText}" />
                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Content="{StaticResource ConnectServiceText}"
                            Command="{Binding ConnectMcpCommand}"
                            MinWidth="88"
                            Height="34"
                            Margin="8,0,0,0"
                            Padding="12,4"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="{Binding McpStatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,8"
                        Padding="10,8"
                        Background="#FFFFF7ED"
                        BorderBrush="#FFF59E0B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding SelectedSlide.IsInitialPromptThemeOutdated, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{StaticResource ThemeOutdatedWarningTitleText}"
                                       Foreground="#FF92400E"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedSlide.InitialPromptThemeStatusText}"
                                       Margin="0,2,12,0"
                                       Foreground="#FF92400E"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{StaticResource ResetInitialPromptToLatestThemeHintText}"
                                       Margin="0,2,12,0"
                                       Foreground="#FF92400E"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{StaticResource ResetInitialPromptToLatestThemeText}"
                                Command="{Binding SelectedSlide.ResetInitialPromptToLatestThemeCommand}"
                                Visibility="{Binding SelectedSlide.CanResetInitialPromptToLatestTheme, Converter={StaticResource BooleanToVisibility}}"
                                VerticalAlignment="Center"
                                MinWidth="150"
                                Height="32"
                                Padding="12,4"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                </Border>
                <TextBox x:Name="ChatInputTextBox"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Text="{Binding SelectedSlide.InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                            <Setter Property="MinHeight" Value="42" />
                            <Setter Property="MaxHeight" Value="120" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSlide.HasStartedGenerationConversation}" Value="False">
                                    <Setter Property="MinHeight" Value="180" />
                                    <Setter Property="MaxHeight" Value="320" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,6,0,0">
                    <Button Content="{StaticResource SendMessageText}" Command="{Binding SendMessageCommand}" CommandParameter="{Binding SelectedSlide}" MinWidth="88" Height="28" Style="{StaticResource PrimaryButtonStyle}" Padding="12,2" />
                    <Button Content="{StaticResource CancelMessageText}" Command="{Binding CancelSelectedSlideCommand}" MinWidth="64" Height="28" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Padding="10,2" />
                </StackPanel>
                <CheckBox Grid.Row="2"
                          Grid.Column="0"
                          IsChecked="{Binding SelectedSlide.AttachPreview}"
                          Margin="0,6,0,0"
                          FontSize="12"
                          Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock Text="{StaticResource AttachCurrentPreviewText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </CheckBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
