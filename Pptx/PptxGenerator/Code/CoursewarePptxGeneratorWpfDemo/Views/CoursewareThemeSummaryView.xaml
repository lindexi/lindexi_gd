<UserControl x:Class="CoursewarePptxGeneratorWpfDemo.Views.CoursewareThemeSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1500"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ThemeColumnStyle" TargetType="Border" BasedOn="{StaticResource AnalysisCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="ThemeColumnTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AnalysisCardTitleTextStyle}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,11" />
        </Style>
        <Style x:Key="ThemeContentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AnalysisBodyTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="23" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource AnalysisHeroBackgroundBrush}"
            BorderBrush="#56C7BE"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,13">
        <StackPanel>
            <TextBlock Text="{StaticResource ThemeSuggestionPanelTitleText}" Foreground="{StaticResource AnalysisNavyBrush}" FontSize="21" FontWeight="Bold" />
            <TextBlock Margin="0,3,0,12" Text="Theme 2.0 完整结果" Style="{StaticResource ThemeContentTextStyle}" />

            <Border Style="{StaticResource ThemeColumnStyle}">
                <StackPanel>
                    <TextBlock Text="ColorSuggestions" Style="{StaticResource ThemeColumnTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding ThemeColors}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="210" Background="#F4F8FA" CornerRadius="8" Margin="0,0,10,10" Padding="10">
                                    <StackPanel>
                                        <Border Height="30" CornerRadius="6" BorderBrush="#D7E2E7" BorderThickness="1">
                                            <Border.Background><SolidColorBrush Color="{Binding Hex}" /></Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ThemeContentTextStyle}" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding Usage}" Style="{StaticResource ThemeContentTextStyle}" />
                                        <TextBlock Text="{Binding Hex}" Foreground="{StaticResource AnalysisMutedBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ThemeColumnStyle}">
                    <StackPanel>
                        <TextBlock Text="Fonts" Style="{StaticResource ThemeColumnTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding TypographyLevels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ThemeContentTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Specification}" Style="{StaticResource ThemeContentTextStyle}" Foreground="#2563EB" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ThemeColumnStyle}">
                    <StackPanel>
                        <TextBlock Text="SafeArea" Style="{StaticResource ThemeColumnTitleStyle}" />
                        <TextBlock Text="{Binding SafeAreaText}" Style="{StaticResource ThemeContentTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ThemeColumnStyle}">
                <StackPanel><TextBlock Text="Style" Style="{StaticResource ThemeColumnTitleStyle}" /><TextBlock Text="{Binding ThemeStyle}" Style="{StaticResource ThemeContentTextStyle}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource ThemeColumnStyle}">
                <StackPanel><TextBlock Text="SpacingAndVisualEffects" Style="{StaticResource ThemeColumnTitleStyle}" /><TextBlock Text="{Binding SpacingAndVisualEffects}" Style="{StaticResource ThemeContentTextStyle}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource ThemeColumnStyle}">
                <StackPanel><TextBlock Text="LayoutPrinciples" Style="{StaticResource ThemeColumnTitleStyle}" /><TextBlock Text="{Binding ThemeLayoutPrinciples}" Style="{StaticResource ThemeContentTextStyle}" /></StackPanel>
            </Border>

            <Expander Header="CoverPageSlideMl" IsExpanded="False" Margin="0,0,0,10">
                <TextBox Text="{Binding CoverPageSlideMl, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="320" Padding="10" />
            </Expander>
            <Expander Header="ContentPageSlideMl" IsExpanded="False">
                <TextBox Text="{Binding ContentPageSlideMl, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="320" Padding="10" />
            </Expander>
        </StackPanel>
    </Border>
</UserControl>