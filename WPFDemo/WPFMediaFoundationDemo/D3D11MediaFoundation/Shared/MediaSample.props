<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-x86'">x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183" PrivateAssets="all" />
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" Link="Shared/%(Filename)%(Extension)" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)NativeMethods.txt;$(MSBuildThisFileDirectory)NativeMethods.json" />
    <None Include="$(MSBuildThisFileDirectory)../../../Video/视频.mp4" Link="Video/视频.mp4" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
