<Window x:Class="WPFD3D11MediaEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFD3D11MediaEngine"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Border x:Name="ImageBorder"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="ImageBorder_SizeChanged">
            <Image x:Name="Image"/>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="ProgressSlider" Orientation="Horizontal" Minimum="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5 0"
                    IsMoveToPointEnabled="True" ValueChanged="ProgressSlider_ValueChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0">
                <TextBlock x:Name="CurrentTextBlock" Text="00:00:00"/>
                <TextBlock Text="/"/>
                <TextBlock x:Name="DurationTextBlock" Text="00:00:00"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <Button Margin="5" Width="40" Content="Open" Click="OpenButton_Click"/>
            <Button Margin="5" Width="40" Content="Play" Click="PlayButton_Click"/>
            <Button Margin="5" Width="40" Content="Pause" Click="PauseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
