<Window x:Class="GanufalallcairJearnocheehiche.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}"
        Width="1080"
        Height="760"
        MinWidth="920"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F2F6FC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="IconBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#55D8F1" />
            <GradientStop Offset="0.48" Color="#18AEEF" />
            <GradientStop Offset="1" Color="#0879EF" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="IconHighlightBrush" Center="0.25,0.15" GradientOrigin="0.18,0.08" RadiusX="0.85" RadiusY="0.78">
            <GradientStop Offset="0" Color="#66FFFFFF" />
            <GradientStop Offset="0.55" Color="#12FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="LongShadowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#29005CC9" />
            <GradientStop Offset="1" Color="#00005CC9" />
        </LinearGradientBrush>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,0,24">
            <TextBlock Text="{DynamicResource AppTitle}" FontSize="28" FontWeight="Bold" Foreground="#15243B" />
            <TextBlock Margin="0,6,0,0" Text="{DynamicResource PreviewDescription}" FontSize="14" Foreground="#637086" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="22" Background="White" CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.1" Color="#10213B" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,0,0,16">
                        <TextBlock Text="{DynamicResource PreviewTitle}" FontSize="17" FontWeight="SemiBold" Foreground="#17243A" />
                        <TextBlock Margin="0,4,0,0" Text="512 × 512" Foreground="#8591A5" />
                    </StackPanel>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Grid x:Name="IconArtwork" Width="512" Height="512" ClipToBounds="True" Background="Transparent">
                            <Border Margin="6" Background="{StaticResource IconBackgroundBrush}" CornerRadius="116">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Color="#075DB4" />
                                </Border.Effect>
                            </Border>
                            <Border Margin="6" Background="{StaticResource IconHighlightBrush}" CornerRadius="116" />

                            <Path Data="M258,145 L466,353 L466,472 Q466,506 432,506 L328,506 L126,304 Z"
                                  Fill="{StaticResource LongShadowBrush}" />
                            <Path Data="M198,331 L367,500 L224,506 L129,411 Z"
                                  Fill="{StaticResource LongShadowBrush}" />

                            <Path Data="M159,144 H353 Q390,144 390,181 V286 Q390,323 353,323 H199 L130,365 L148,323 Q122,313 122,282 V181 Q122,144 159,144 Z"
                                  Fill="#0BFFFFFF"
                                  Stroke="#F8FCFF"
                                  StrokeThickness="15"
                                  StrokeLineJoin="Round">
                                <Path.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.28" Color="#0874C8" />
                                </Path.Effect>
                            </Path>

                            <Path Data="M221,190 L178,234 L221,278"
                                  Stroke="White"
                                  StrokeThickness="17"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round">
                                <Path.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="315" Opacity="0.22" Color="#0874C8" />
                                </Path.Effect>
                            </Path>
                            <Path Data="M291,190 L334,234 L291,278"
                                  Stroke="White"
                                  StrokeThickness="17"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round">
                                <Path.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="315" Opacity="0.22" Color="#0874C8" />
                                </Path.Effect>
                            </Path>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="24" Background="White" CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.1" Color="#10213B" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource ExportTitle}" FontSize="19" FontWeight="SemiBold" Foreground="#17243A" />
                    <Border Height="1" Margin="0,16,0,18" Background="#E8ECF3" />
                    <TextBlock Text="PNG" FontWeight="SemiBold" Foreground="#324158" />
                    <TextBlock Margin="0,6,0,18" Text="{DynamicResource ExportDescription}" TextWrapping="Wrap" LineHeight="22" Foreground="#6D798C" />
                    <TextBlock Text="ICO" FontWeight="SemiBold" Foreground="#324158" />
                    <TextBlock Margin="0,6,0,18" Text="{DynamicResource IcoDescription}" TextWrapping="Wrap" LineHeight="22" Foreground="#6D798C" />
                    <TextBlock Text="{DynamicResource OutputTitle}" FontWeight="SemiBold" Foreground="#324158" />
                    <Border Margin="0,8,0,24" Padding="10" Background="#F4F7FB" CornerRadius="7">
                        <TextBlock x:Name="OutputPathTextBlock" TextWrapping="Wrap" Foreground="#59677B" FontSize="12" />
                    </Border>
                    <Button x:Name="ExportPngButton" Style="{StaticResource ActionButtonStyle}" Background="#158DE5"
                            Content="{DynamicResource ExportPngButton}" Click="ExportPngButton_Click" />
                    <Button x:Name="ExportIcoButton" Style="{StaticResource ActionButtonStyle}" Background="#3972B9"
                            Content="{DynamicResource ExportIcoButton}" Click="ExportIcoButton_Click" />
                    <Button x:Name="ExportAllButton" Style="{StaticResource ActionButtonStyle}" Background="#124D8E"
                            Content="{DynamicResource ExportAllButton}" Click="ExportAllButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,20,0,0" Padding="14,10" Background="#E8F4FF" CornerRadius="9">
            <TextBlock x:Name="StatusTextBlock" Text="{DynamicResource ReadyStatus}" Foreground="#25629D" />
        </Border>
    </Grid>
</Window>
