<Application x:Class="QeechegayyalbeaheJerhernawwulear.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <sys:String x:Key="AppTitle">图标绘制与导出</sys:String>
        <sys:String x:Key="PreviewTitle">矢量图标预览</sys:String>
        <sys:String x:Key="PreviewDescription">使用 WPF 图形、渐变和阴影实时绘制</sys:String>
        <sys:String x:Key="ExportTitle">导出设置</sys:String>
        <sys:String x:Key="ExportDescription">PNG：512 × 512、64 × 64、32 × 32</sys:String>
        <sys:String x:Key="IcoDescription">ICO：合并 256 × 256、64 × 64、32 × 32</sys:String>
        <sys:String x:Key="OutputTitle">默认输出目录</sys:String>
        <sys:String x:Key="ExportPngButton">导出 PNG</sys:String>
        <sys:String x:Key="ExportIcoButton">导出 ICO</sys:String>
        <sys:String x:Key="ExportAllButton">全部导出</sys:String>
        <sys:String x:Key="ReadyStatus">准备就绪</sys:String>
    </Application.Resources>
</Application>
