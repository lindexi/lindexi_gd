<Application x:Class="MediaFoundation.PlayerDemo.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <ResourceDictionary xmlns:sys="clr-namespace:System;assembly=System.Runtime">
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MediaFoundation.Wpf;component/Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
   <sys:String x:Key="DemoTitle">Media Foundation 播放器</sys:String>
   <sys:String x:Key="SelfTestMediaRequiredText">自测需要显式指定媒体文件路径：--self-test &lt;媒体文件路径&gt;</sys:String>
   <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#142638"/>
   <SolidColorBrush x:Key="PlayerAccentBrush" Color="#FFB347"/>
   <SolidColorBrush x:Key="PlayerForegroundBrush" Color="#FFF5E0"/>
   <SolidColorBrush x:Key="PlayerControlBackgroundBrush" Color="#253D50"/>
   <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerBaseButtonStyle}">
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource PlayerControlBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}"/>
    <Setter Property="MinHeight" Value="40"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
