<Application x:Class="MediaFoundation.PlayerDemo.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MediaFoundation.Controls;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#131820" />
            <SolidColorBrush x:Key="PlayerAccentBrush" Color="#64BEFF" />
            <SolidColorBrush x:Key="PlayerForegroundBrush" Color="#EEF4FA" />
            <SolidColorBrush x:Key="PlayerControlBackgroundBrush" Color="#1C2936" />
            <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerBaseButtonStyle}">
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
