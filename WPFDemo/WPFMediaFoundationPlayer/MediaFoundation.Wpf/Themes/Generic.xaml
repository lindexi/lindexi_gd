<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:MediaFoundation.Controls">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/MediaFoundation.Controls;component/Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="{x:Type local:MediaPlayerControl}">
  <Setter Property="Background" Value="{DynamicResource PlayerBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PlayerForegroundBrush}"/>
  <Setter Property="MinWidth" Value="580"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:MediaPlayerControl}">
   <Grid Background="{TemplateBinding Background}" UseLayoutRounding="True">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="EmptyHint" Text="{DynamicResource PlayerEmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PlayerForegroundBrush}" Opacity="0.6" FontSize="16" Visibility="Collapsed"/>
    <ContentControl x:Name="Video" Content="{Binding Player.VideoView, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Border Grid.Row="1" Padding="12,12" Background="{DynamicResource PlayerBackgroundBrush}">
     <StackPanel>
      <TextBlock x:Name="Status" Text="{TemplateBinding StatusText}" TextWrapping="Wrap" Margin="4,0,4,6" AutomationProperties.LiveSetting="Polite"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Slider x:Name="PART_Progress" Minimum="0" IsEnabled="{Binding Player.CanSeek, RelativeSource={RelativeSource TemplatedParent}}" Style="{DynamicResource PlayerSliderStyle}" ToolTip="{DynamicResource PlayerSeekText}" AutomationProperties.Name="{DynamicResource PlayerSeekText}"/>
       <TextBlock x:Name="Time" Grid.Column="1" Text="{TemplateBinding TimeText}" VerticalAlignment="Center" Width="164" TextAlignment="Right" FontFamily="Consolas" Typography.NumeralAlignment="Tabular" Margin="12,0,4,0" FontSize="12"/>
      </Grid>
      <Grid Height="44"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal">
        <Button x:Name="Open" Command="{x:Static local:MediaPlayerControl.OpenFileCommand}" Style="{DynamicResource PlayerButtonStyle}" ToolTip="{DynamicResource PlayerOpenText}" AutomationProperties.Name="{DynamicResource PlayerOpenText}"><Path Style="{StaticResource PlayerIconStyle}" Data="M1,4 L8,4 10,7 21,7 21,10 5,10 2,20 0,20 0,4 Z M6,11 L24,11 21,20 3,20 Z"/></Button>
        <Button x:Name="Play" Command="{x:Static local:MediaPlayerControl.PlayPauseCommand}" Background="{DynamicResource PlayerAccentBrush}" Foreground="{DynamicResource PlayerBackgroundBrush}" Style="{DynamicResource PlayerButtonStyle}" ToolTip="{DynamicResource PlayerPlayText}" AutomationProperties.Name="{DynamicResource PlayerPlayText}"><Path x:Name="PlayIcon"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource PlayerIconStyle}"><Setter Property="Data" Value="M3,1 L21,12 3,23 Z"/></Style></Path.Style></Path></Button>
        <Button x:Name="Stop" Command="{x:Static local:MediaPlayerControl.StopCommand}" Style="{DynamicResource PlayerButtonStyle}" ToolTip="{DynamicResource PlayerStopText}" AutomationProperties.Name="{DynamicResource PlayerStopText}"><Path Style="{StaticResource PlayerIconStyle}" Data="M2,2 H22 V22 H2 Z"/></Button>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="Mute" Command="{x:Static local:MediaPlayerControl.MuteCommand}" Style="{DynamicResource PlayerButtonStyle}" ToolTip="{DynamicResource PlayerMuteText}" AutomationProperties.Name="{DynamicResource PlayerMuteText}"><Path x:Name="MuteIcon"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource PlayerIconStyle}"><Setter Property="Data" Value="M0,8 H5 L12,2 V22 L5,16 H0 Z M16,5 L18,4 Q26,12 18,20 L16,19 Q22,12 16,5 Z"/></Style></Path.Style></Path></Button>
        <Slider x:Name="Volume" Width="80" Minimum="0" Maximum="1" Value="{Binding Player.Volume, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{DynamicResource PlayerSliderStyle}" ToolTip="{DynamicResource PlayerVolumeText}" AutomationProperties.Name="{DynamicResource PlayerVolumeText}"/>
        <ComboBox x:Name="Rate" SelectedValuePath="Content" SelectedValue="{Binding Player.PlaybackRate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{DynamicResource PlayerComboBoxStyle}" ToolTip="{DynamicResource PlayerRateText}" AutomationProperties.Name="{DynamicResource PlayerRateText}">
         <ComboBoxItem><sys:Double>0.5</sys:Double></ComboBoxItem><ComboBoxItem><sys:Double>1</sys:Double></ComboBoxItem><ComboBoxItem><sys:Double>1.5</sys:Double></ComboBoxItem><ComboBoxItem><sys:Double>2</sys:Double></ComboBoxItem>
        </ComboBox>
        <ContentPresenter Content="{TemplateBinding ToolbarContent}" VerticalAlignment="Center"/>
        <Button x:Name="Loop" Command="{x:Static local:MediaPlayerControl.LoopCommand}" Style="{DynamicResource PlayerButtonStyle}" ToolTip="{DynamicResource PlayerLoopText}" AutomationProperties.Name="{DynamicResource PlayerLoopText}"><Path Style="{StaticResource PlayerIconStyle}" Data="M4,5 H17 V1 L23,7 17,13 V9 H5 V14 H1 V8 Q1,5 4,5 Z M20,19 H7 V23 L1,17 7,11 V15 H19 V10 H23 V16 Q23,19 20,19 Z"/></Button>
        <Button x:Name="Fullscreen" Command="{x:Static local:MediaPlayerControl.FullscreenCommand}" Style="{DynamicResource PlayerButtonStyle}" ToolTip="{DynamicResource PlayerFullscreenText}" AutomationProperties.Name="{DynamicResource PlayerFullscreenText}"><Path x:Name="FullscreenIcon"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource PlayerIconStyle}"><Setter Property="Data" Value="M0,0 H9 V3 H3 V9 H0 Z M15,0 H24 V9 H21 V3 H15 Z M0,15 H3 V21 H9 V24 H0 Z M21,15 H24 V24 H15 V21 H21 Z"/></Style></Path.Style></Path></Button>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <DataTrigger Binding="{Binding Player.Source, RelativeSource={RelativeSource Self}}" Value="{x:Null}"><Setter TargetName="Video" Property="Visibility" Value="Collapsed"/><Setter TargetName="EmptyHint" Property="Visibility" Value="Visible"/><Setter TargetName="Status" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <Trigger Property="StatusText" Value=""><Setter TargetName="Status" Property="Visibility" Value="Collapsed"/></Trigger>
    <DataTrigger Binding="{Binding Player.CanPause, RelativeSource={RelativeSource Self}}" Value="True">
     <Setter TargetName="PlayIcon" Property="Data" Value="M3,1 H9 V23 H3 Z M15,1 H21 V23 H15 Z"/>
     <Setter TargetName="Play" Property="ToolTip" Value="{DynamicResource PlayerPauseText}"/><Setter TargetName="Play" Property="AutomationProperties.Name" Value="{DynamicResource PlayerPauseText}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Player.IsMuted, RelativeSource={RelativeSource Self}}" Value="True">
     <Setter TargetName="MuteIcon" Property="Data" Value="M0,8 H5 L12,2 V22 L5,16 H0 Z M16,6 L20,10 24,6 26,8 22,12 26,16 24,18 20,14 16,18 14,16 18,12 14,8 Z"/>
     <Setter TargetName="Mute" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/><Setter TargetName="Mute" Property="ToolTip" Value="{DynamicResource PlayerUnmuteText}"/><Setter TargetName="Mute" Property="AutomationProperties.Name" Value="{DynamicResource PlayerUnmuteText}"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Player.IsLooping, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="Loop" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/><Setter TargetName="Loop" Property="BorderBrush" Value="{DynamicResource PlayerAccentBrush}"/></DataTrigger>
    <Trigger Property="IsFullscreen" Value="True"><Setter TargetName="FullscreenIcon" Property="Data" Value="M6,0 H9 V9 H0 V6 H6 Z M15,0 H18 V6 H24 V9 H15 Z M0,15 H9 V24 H6 V18 H0 Z M15,15 H24 V18 H18 V24 H15 Z"/><Setter TargetName="Fullscreen" Property="Foreground" Value="{DynamicResource PlayerAccentBrush}"/><Setter TargetName="Fullscreen" Property="ToolTip" Value="{DynamicResource PlayerExitFullscreenText}"/><Setter TargetName="Fullscreen" Property="AutomationProperties.Name" Value="{DynamicResource PlayerExitFullscreenText}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>