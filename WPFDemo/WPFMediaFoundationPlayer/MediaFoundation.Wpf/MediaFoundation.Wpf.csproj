<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MediaFoundation.Controls</AssemblyName>
    <RootNamespace>MediaFoundation.Controls</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MediaFoundation.Core/MediaFoundation.Core.csproj" />
    <PackageReference Include="DotNetCampus.SourceLocalizations" Version="0.1.1-alpha.9" PrivateAssets="all" ExcludeAssets="runtime" />
    <EmbeddedResource Remove="**/*.resx" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183" PrivateAssets="all" />
  </ItemGroup>
</Project>
