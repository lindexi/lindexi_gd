<Window x:Class="Pano.Net.DirectX11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pano.Net - Silk.NET DirectX 11 / D3DImage" Width="1200" Height="720"
        Background="Black">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="打开全景图" Click="OpenImage_Click" />
            <Button Content="复制状态" Click="CopyStatus_Click" />
            <Separator />
            <TextBox x:Name="StatusText"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     MinWidth="800" />
        </ToolBar>
        <Grid Background="Black">
            <Image x:Name="RenderImage" Stretch="Fill"
                   IsManipulationEnabled="True"
                   MouseLeftButtonDown="RenderImage_MouseLeftButtonDown"
                   MouseLeftButtonUp="RenderImage_MouseLeftButtonUp"
                   MouseMove="RenderImage_MouseMove"
                   MouseWheel="RenderImage_MouseWheel"
                   ManipulationStarting="RenderImage_ManipulationStarting"
                   ManipulationDelta="RenderImage_ManipulationDelta" />
        </Grid>
    </DockPanel>
</Window>
